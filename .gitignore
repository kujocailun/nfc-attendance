# Root allowlist: existing private course notes and delivery files stay local.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/VERSION
!/CHANGELOG.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/platformio.ini
!/src/
!/lib/
!/certs/
!/test/
!/tools/
!/admin/
!/docs/

# Only reviewed backend files enter Git.
/admin/*
!/admin/database.py
!/admin/device.py
!/admin/validation.py
!/admin/server.py
!/admin/network_server.py
!/admin/netstore.py
!/admin/requirements.txt
!/admin/requirements-lock.txt
!/admin/network-config.example.json
!/admin/start.ps1
!/admin/stop.ps1
!/admin/启动后台.cmd
!/admin/停止后台.cmd
!/admin/static/
!/admin/deploy/
!/admin/tests/
/admin/tests/*
!/admin/tests/test_admin.py
!/admin/tests/test_network.py
!/admin/tests/test_status_refresh.cjs
/admin/deploy/*
!/admin/deploy/install.ps1
!/admin/deploy/prepare.py
!/admin/deploy/register-startup.ps1
!/admin/deploy/unregister-startup.ps1
!/admin/deploy/run.ps1
!/admin/deploy/启动联网后台.cmd

# Packaging scripts from private deployment bundles are intentionally excluded.
/tools/*
!/tools/check_public.py
!/tools/test_native.py
!/tools/package_source.py
!/tools/make_cert_bundle.py

# Credentials, local endpoint overrides and deployment state.
.env
.env.*
**/network-config.json
**/project_config.h
**/deploy-state/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Attendance records, private evidence and generated artifacts.
**/data/
**/backups/
**/update-backups/
**/migration/
**/*.sqlite*
**/*.db
**/*.csv
**/*.log
**/*.zip
**/*.bin
**/*.elf
**/*.map
**/*.exe
**/*.pyc
**/__pycache__/
**/.venv/
**/node_modules/
**/wheelhouse/
**/test-output/
.DS_Store
Thumbs.db
